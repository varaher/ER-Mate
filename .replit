entrypoint = "README.md"
modules = ["nodejs-22", "python-3.11", "node", "postgresql-16"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "REPLIT_INTERNAL_APP_DOMAIN=er-mate.replit.app npm run expo:static:build && npm run server:build"]
run = ["npm", "run", "server:prod"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3002

[env]
PORT = "5000"

[agent]
stack = "EXPO"
integrations = ["javascript_openai_ai_integrations:2.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start App"

[[workflows.workflow]]
name = "Start App"
author = "agent"
mode = "parallel"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "REPLIT_INTERNAL_APP_DOMAIN=er-mate.replit.app npm run expo:static:build && npm run server:dev"
waitForPort = 5000

[userenv]

[userenv.shared]
EXPO_PUBLIC_EXTERNAL_API_URL = "https://er-emr-backend.onrender.com/api"
EXPO_PUBLIC_DOMAIN = "cc70901c-5ae8-4394-a8d0-9961ae7b57dc-00-1obtc7pzxu7ls.picard.replit.dev"
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID = "1018674231904-qjp0qr7bvc3sh792mq74inbf02gdqtkb.apps.googleusercontent.com"
APP_URL = "https://ermate.in"
RESEND_FROM_DOMAIN = "ermate.in"
